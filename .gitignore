# Abhängigkeiten
/vendor/

# Zugangsdaten – niemals committen
/config/config.local.php
/config/config.test.php

# PHPUnit
/.phpunit.cache/

# Editoren und Betriebssystem
/.idea/
/.vscode/
Thumbs.db
.DS_Store

# Logs
*.log

# Lokale Laufzeitdaten, z. B. Mails als .eml (mail.transport = file; enthalten Links mit Tokens)
/var/

# Lokale Tests der API mit curl (Sitzungs-Token, Zugangsdaten)
/cookies.txt
/login.json
/request.json
/reset.json

# Live-Lauf (npm run test:live-offline): Zugangsdaten und Sitzungen nur lokal, nie committen
/frontend/tests/live/.env.local
/frontend/tests/live/*.storage.json

# Benutzertest: lokaler Schlüssel der Testdatenbank
/frontend/tests/usability/state-return-link.txt
