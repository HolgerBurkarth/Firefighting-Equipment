{
    "name": "prodad/firefighting-equipment",
    "description": "Webanwendung zur Verwaltung von Feuerwehr-Geräten, Standorten und Status",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "FirefightingEquipment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FirefightingEquipment\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    }
}
